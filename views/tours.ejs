<%- include('partials/header', {title: 'Tours'}) -%> <%-
include('partials/navbar') -%> <%- include("partials/toast") -%>

<!--TOURS SECTION-->

<link rel="stylesheet" href="./stylesheets/tours.css" />

<section id="tours-section">
  <div class="container-xxl flex-wrap flex-md-nowrap">
    <h2 class="p-5" data-aos="fade-left">
      Most popular tours booked by our customers
    </h2>
    <div
      class="accordion accordion-flush shadow-dp-12"
      data-aos="fade-right"
      id="accordionFlushExample"
    >
      <% toursData.forEach((tour, index) => { %>
      <div class="accordion-item">
        <h2 class="accordion-header" id="flush-header-<%- tour._id %>">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#flush-<%- tour._id %>"
            aria-expanded="false"
            aria-controls="flush-collapseOne"
          >
            <h5><%- tour.tourName %></h5>
          </button>
        </h2>
        <div
          id="flush-<%- tour._id %>"
          class="accordion-collapse collapse"
          aria-labelledby="flush-header-<%- tour._id %>"
          data-bs-parent="#accordionFlushExample"
        >
          <div class="accordion-body">
            <div class="row">
              <div class="col-sm-12 col-lg-12">
                <% tour.tourPlaces.forEach((place, index) => { %>
                <img
                  src="images/tours/<%= place %>.jpg"
                  alt="<% place %>"
                  class="m-2"
                  loading="lazy"
                />
                <p class="tour-places h5"><%- place %></p>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include("partials/footer") -%> <%- include("partials/foot") -%>
