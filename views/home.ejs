    <!-- TESTIMONIALS SECTION -->

    <section id="testimonials-section">
        <div class="container-xxl flex-wrap flex-md-nowrap">
            <h2 class="p-5">Happy Travellers</h2>
            <div class="testimonial-container shadow-dp-8">
                <div class="row">
                    <div class="col-2 d-flex justify-content-center align-items-center">
                        <i class="fas fa-quote-left align-middle"></i>
                    </div>
                    <div class="col d-flex justify-content-center align-items-center">
                        <div id="carouselExampleSlidesOnly" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                <% testimonials.forEach(function (item, index) { %>
                                    <% if ( index === 0) { %>
                                <div class="carousel-item active">
                                    <% } else { %>
                                    <div class="carousel-item">
                                        <% } %>
                                        <p><%= item.text %></p>
                                        <em class="testimonials-author">
                                            - <%= item.author %>
                                        </em>
                                    </div>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                        <div class="col-2 d-flex justify-content-center align-items-center">
                            <i class="fas fa-quote-right"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
