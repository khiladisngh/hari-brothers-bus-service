rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read for testimonials displayed on homepage
    match /testimonials/{doc} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Public read for tour packages
    match /tours/{doc} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Public read for gallery images
    match /galleryImages/{doc} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Contact form submissions - backend only access
    match /messages/{doc} {
      allow read, write: if false; // Only Cloud Functions can access
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
