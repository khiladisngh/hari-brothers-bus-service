<!--FOOTER SECTION-->

<link rel="stylesheet" href="./stylesheets/footer.css" />

<section id="footer-section">
  <div class="container-fluid">
    <footer>
      <div class="brand">Hari Brothers</div>
      <hr />
      <div class="icons d-flex justify-content-center">
        <div class="row">
          <div class="col">
            <a href="https://www.instagram.com/haribusservice" target="_blank">
              <i class="cp-icon fab fa-instagram fa-2x"></i
            ></a>
          </div>
          <div class="col">
            <a href="https://www.facebook.com/haribusservice" target="_blank">
              <i class="cp-icon fab fa-facebook-square fa-2x"></i
            ></a>
          </div>
          <div class="col">
            <a
              href="https://api.whatsapp.com/send?phone=<%= process.env.WHATSAPP_RECEIVER %>"
              target="_blank"
            >
              <i class="cp-icon fab fa-whatsapp-square fa-2x"></i
            ></a>
          </div>
          <div class="col">
            <a href="tel:<%= process.env.CALL %>" target="_blank">
              <i class="cp-icon fas fa-phone-square-alt fa-2x"></i
            ></a>
          </div>
        </div>
      </div>
      <div class="copyright pt-4">
        <div class="overline">
          ©
          <script>
            document.write(new Date().getFullYear());
          </script>
          . Hari Brothers Bus Service. Travel Safe.
        </div>
      </div>
    </footer>
  </div>
</section>
