<%- include('partials/navbar') -%>
<%- include('partials/toast') -%>

<link rel="stylesheet" href="./stylesheets/styles.css" />

<style>
    .error-section {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 4rem 0;
    }
    .error-container {
        background: white;
        border-radius: 20px;
        padding: 3rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        text-align: center;
        max-width: 600px;
    }
    .error-code {
        font-size: 8rem;
        font-weight: 900;
        color: #03A678;
        margin: 0;
        line-height: 1;
    }
    .error-title {
        font-size: 2rem;
        font-weight: 700;
        color: #333;
        margin: 1rem 0;
    }
    .error-message {
        font-size: 1.1rem;
        color: #666;
        margin-bottom: 2rem;
    }
    .btn-home {
        background: #03A678;
        border: none;
        color: white;
        padding: 12px 40px;
        font-size: 1.1rem;
        border-radius: 50px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
    }
    .btn-home:hover {
        background: #028a63;
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(3, 166, 120, 0.3);
        color: white;
    }
    .error-links {
        margin-top: 2rem;
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }
    .error-links a {
        color: #03A678;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s;
    }
    .error-links a:hover {
        color: #028a63;
        text-decoration: underline;
    }
</style>

<section class="error-section">
    <div class="container">
        <div class="error-container" data-aos="fade-up">
            <h1 class="error-code">404</h1>
            <h2 class="error-title">Page Not Found</h2>
            <p class="error-message">
                Oops! The page you're looking for doesn't exist. It might have been moved or deleted.
            </p>
            <a href="/" class="btn-home">Go to Homepage</a>
            <div class="error-links">
                <a href="/tours">Browse Tours</a>
                <span>•</span>
                <a href="/gallery">View Gallery</a>
                <span>•</span>
                <a href="/contact">Contact Us</a>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') -%>
<%- include('partials/foot') -%>
