<%# functions/views/gallery.ejs %>

<%- include('partials/header', {title: 'Gallery'}) -%>
<%- include('partials/navbar') -%>
<%- include("partials/toast") -%>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/baguettebox.js/1.11.1/baguetteBox.min.css" />
<link rel="stylesheet" href="/stylesheets/gallery.css" />

<section id="gallery-section">
  <div class="container-xxl flex-wrap flex-md-nowrap">
    <h1 class="p-3 p-lg-5" data-aos="fade-in">Gallery</h1>
    <div class="gallery">
      <div class="row d-flex justify-content-center">

        <%# Check if galleryItems array exists and has items %>
        <% if (typeof galleryItems !== 'undefined' && galleryItems.length > 0) { %>
          <% galleryItems.forEach((item, index) => { %>
            <%# Use static Bootstrap columns instead of lodash %>
            <div class="col-12 col-sm-6 col-md-4 p-2">
              <% if (item.imageUrls) { %>
                <%# New responsive image format %>
                  <a class="lightbox" href="<%= item.imageUrls.jpeg.large || item.imageUrls.jpeg.original %>">
                    <picture>
                      <source srcset="<%= item.imageUrls.webp.thumbnail %> 300w,
                                            <%= item.imageUrls.webp.medium %> 800w,
                                            <%= item.imageUrls.webp.large %> 1200w"
                        sizes="(max-width: 600px) 100vw, (max-width: 1200px) 50vw, 33vw" type="image/webp">
                      <img src="<%= item.imageUrls.jpeg.medium %>" srcset="<%= item.imageUrls.jpeg.thumbnail %> 300w,
                                            <%= item.imageUrls.jpeg.medium %> 800w,
                                            <%= item.imageUrls.jpeg.large %> 1200w"
                        sizes="(max-width: 600px) 100vw, (max-width: 1200px) 50vw, 33vw" class="shadow-1-strong mb-4"
                        alt="<%= item.altText || 'Gallery Image' %>" data-aos="slide-left" loading="lazy" />
                    </picture>
                  </a>
                  <% } else { %>
                    <%# Fallback for old single-image format %>
                      <a class="lightbox" href="<%= item.imageUrl %>">
                        <img
                    src="<%= item.imageUrl %>"
                    class="shadow-1-strong mb-4"
                    alt="<%= item.altText || 'Gallery Image' %>"
                      data-aos="slide-left"
                      loading="lazy"
                      />
                      </a>
              <% } %>
            </div>
          <% }) %>
        <% } else { %>
          <%# Display message if no items were found %>
          <p class="text-center">No images currently in the gallery.</p>
        <% } %>

      </div>
    </div>
  </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/baguettebox.js/1.11.1/baguetteBox.min.js"></script>
<script>
  if (document.querySelectorAll('.gallery .lightbox').length > 0) {
    baguetteBox.run(".gallery");
  }
</script>

<%- include("partials/footer") -%>
<%- include("partials/foot") -%>
