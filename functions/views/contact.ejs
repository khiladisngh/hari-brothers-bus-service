<%- include('partials/header', {title: 'Contact Us'}) -%> <%-
include('partials/navbar') -%> <%- include("partials/toast") -%>

<!--CONTACT SECTION-->

<link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css"
/>
<link rel="stylesheet" href="./stylesheets/contact.css"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>

<section id="contact-section" class="shadow-dp-6">
    <div class="container-xxl flex-wrap flex-md-nowrap">
        <div class="contact-container shadow-dp-8">
            <h2 class="pt-3" data-aos="fade-down">
                You’re a call away from a great travel experience.
            </h2>
            <div class="row position-relative">
                <div class="col-lg-6 contact-info" data-aos="fade-right">
                    <div class="row pb-5 text-sm-start">
                        <div class="col-sm-6 d-flex flex-column justify-content-between">
                            <h4 class="heading">Phone</h4>
                            <ul class="number">
                                <li>+919411460750</li>
                                <li>+919412343701</li>
                                <li>+917017140452</li>
                                <li>+919458205009</li>
                            </ul>
                        </div>
                        <div class="col-sm-6 d-flex flex-column justify-content-between">
                            <a href="tel:<%= process.env.CALL %>" target="_blank">
                                <button
                                        type="button"
                                        class="btn btn-lg button button-text button-yellow"
                                >
                                    <i class="fas fa-phone-alt"></i>
                                    Call Us
                                </button>
                            </a>
                            <a
                                    href="https://api.whatsapp.com/send?phone=<%= process.env.WHATSAPP %>"
                                    target="_blank"
                            >
                                <button
                                        type="button"
                                        class="btn btn-lg button button-text button-green"
                                >
                                    <i class="fab fa-whatsapp"></i>
                                    Whatsapp
                                </button>
                            </a>
                        </div>
                    </div>
                    <div class="row text-sm-start">
                        <div class="col-sm-6 d-flex flex-column justify-content-between">
                            <h4 class="heading">Address</h4>
                            <p class="text address">
                                Shop No - 573, Sultanpura Station Road, Agra, Uttar Pradesh -
                                282001
                            </p>
                        </div>
                        <div class="col-sm-6 d-flex flex-column justify-content-center">
                            <a
                                    href="https://www.google.com/maps/place/Hari+Brothers+Bus+Service/@27.1580264,77.9945573,17z/data=!3m1!4b1!4m5!3m4!1s0x397476c27e53cad9:0xd857d1f4d56b97d9!8m2!3d27.1580264!4d77.9967513"
                            >
                                <button
                                        type="button"
                                        class="btn button button-text button-yellow"
                                >
                                    <i class="fas fa-compass"></i>
                                    Get Directions
                                </button>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="line"></div>
                <div class="col-lg-6 message-form" data-aos="fade-left">
                    <form action="contact" method="post" class="row g-3">
                        <div class="form-floating col-md-6">
                            <input
                                    type="text"
                                    name="firstName"
                                    class="form-control"
                                    id="inputFirstName"
                                    placeholder="First Name"
                                    required
                            />
                            <label for="inputFirstName">First Name</label>
                        </div>
                        <div class="form-floating col-md-6">
                            <input
                                    type="text"
                                    name="lastName"
                                    class="form-control"
                                    id="inputLastName"
                                    placeholder="Last Name"
                                    required
                            />
                            <label for="inputLastName">Last Name</label>
                        </div>
                        <div class="form-floating col-12">
                            <input
                                    type="number"
                                    name="phoneNumber"
                                    class="form-control"
                                    id="inputNumber"
                                    placeholder="+91"
                                    required
                            />
                            <label for="inputNumber">Phone Number</label>
                        </div>
                        <div class="form-floating col-md-6">
                            <select
                                    id="inputFromState"
                                    name="fromState"
                                    class="form-select"
                                    required
                            >
                                <option selected>Select State</option>
                            </select>
                            <label for="inputFromState">From State</label>
                        </div>
                        <div class="form-floating col-md-6">
                            <select
                                    id="inputFromCity"
                                    name="fromCity"
                                    class="form-select"
                                    required
                            >
                                <option selected>Select City</option>
                            </select>
                            <label for="inputFromCity">From City</label>
                        </div>
                        <div class="form-floating col-md-6">
                            <select
                                    id="inputToState"
                                    name="toState"
                                    class="form-select"
                                    required
                            >
                                <option selected>Select State</option>
                            </select>
                            <label for="inputToState">To State</label>
                        </div>
                        <div class="form-floating col-md-6">
                            <select
                                    id="inputToCity"
                                    name="toCity"
                                    class="form-select"
                                    required
                            >
                                <option selected>Select City</option>
                            </select>
                            <label for="inputToCity">To City</label>
                        </div>
                        <div class="form-floating col-md-12">
                            <label for="date"></label>
                            <div class="input-group date" id="datepicker">
                                <input
                                        type="text"
                                        name="date"
                                        class="form-date form-control"
                                        placeholder="Date"
                                />
                                <span class="input-group-append">
                  <span class="input-group-text bg-white d-block">
                    <i class="fa fa-calendar"></i>
                  </span>
                </span>
                            </div>
                        </div>
                        <div class="form-floating col-12">
              <textarea
                      class="form-control"
                      name="message"
                      placeholder="Leave a comment here"
                      id="floatingTextarea2"
                      style="height: 100px"
                      required
              ></textarea>
                            <label for="floatingTextarea2">Ask us for your next trip</label>
                        </div>
                        <div class="col-12">
                            <button
                                    type="submit"
                                    class="btn button button-text button-yellow"
                            >
                                Get A Quote
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="map-section">
    <div class="container-fluid p-0">
        <iframe
                src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d4013.563209706147!2d77.99634320713339!3d27.15774636359784!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0xd857d1f4d56b97d9!2sHari%20Brothers%20Bus%20Service!5e0!3m2!1sen!2sin!4v1634727315207!5m2!1sen!2sin"
                width="100%"
                height="500"
                style="border: 0"
                allowfullscreen=""
                loading="lazy"
        ></iframe>
    </div>
</section>

<script>
    $(document).ready(function () {
        // Load states from json file.
        $.getJSON("/json/indianStates.json")
            .done(function (data) {
                $.each(data["states"], function (key, value) {
                    $("#inputFromState").append(
                        "<option value='" + value["name"] + "'>" + value["name"] + "</option>"
                    );
                    $("#inputToState").append(
                        "<option value='" + value["name"] + "'>" + value["name"] + "</option>"
                    );
                });
            })
            .fail(function (jqxhr, textStatus, error) {
                const err = textStatus + ", " + error;
                console.log("Request Failed: " + err);
            });

        // Load cities from json file based on selected state for "From" dropdown
        $(document).on("change", "#inputFromState", function () {
            const selectedState = $("#inputFromState").val();
            if (selectedState === "") {
                $("#inputFromCity").empty().append("<option selected>Select City</option>");
                return;
            }
            $("#inputFromCity").empty().append("<option selected>Loading...</option>");
            populateCities(selectedState, "#inputFromCity");
        });

        // Load cities from json file based on selected state for "To" dropdown
        $(document).on("change", "#inputToState", function () {
            const selectedState = $("#inputToState").val();
            if (selectedState === "") {
                $("#inputToCity").empty().append("<option selected>Select City</option>");
                return;
            }
            $("#inputToCity").empty().append("<option selected>Loading...</option>");
            populateCities(selectedState, "#inputToCity");
        });

        function populateCities(selectedState, cityDropdownId) {
            $.getJSON("/json/indianStates.json")
                .done(function (data) {
                    const states = data.states;
                    const selectedStateObj = states.find(function (state) {
                        return state.name === selectedState;
                    });
                    if (selectedStateObj) {
                        $(cityDropdownId).empty().append("<option selected>Select City</option>");
                        selectedStateObj.districts.forEach(function (district) {
                            const option = `<option value="${district.name}">${district.name}</option>`;
                            $(cityDropdownId).append(option);
                        });
                    } else {
                        $(cityDropdownId).empty().append("<option selected>Select City</option>");
                    }
                })
                .fail(function (jqxhr, textStatus, error) {
                    const err = textStatus + ", " + error;
                    console.log("Request Failed: " + err);
                    $(cityDropdownId).empty().append("<option selected>Error Loading Cities</option>");
                });
        }
    });
</script>

<script type="text/javascript">
    $(function () {
        $("#datepicker").datepicker();
    });
</script>

<%- include("partials/footer") -%> <%- include("partials/foot") -%>
