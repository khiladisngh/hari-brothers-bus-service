# Environment variables for local development
# Copy this file to .env and fill in the actual values

# Email configuration
EMAIL_USER=your-email@gmail.com
CONTACT_FORM_RECIPIENT=recipient-email@gmail.com

# NOTE: EMAIL_PASSWORD is managed via Firebase Secret Manager
# To set it up:
# 1. Go to Firebase Console > Functions > Secrets
# 2. Create a secret named "EMAIL_PASSWORD" with your Gmail app password
# 3. Grant access to the Cloud Functions service account
# 
# For local development, you can temporarily add:
# EMAIL_PASSWORD=your-gmail-app-password
# (Remove before committing to git)
